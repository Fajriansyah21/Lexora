# Local environment template for @lexora/web.
# Copy this file to .env.local and fill in real local credentials.
# .env.local is ignored by Git; never commit credentials.

# PostgreSQL 18 connection for local development.
# Format: postgresql://<role>:<password>@<host>:<port>/<database>
# Role: lexora_app (never the postgres superuser). Database: lexora_dev.
DATABASE_URL="postgresql://lexora_app:***@127.0.0.1:5432/lexora_dev"

# Better Auth server-only configuration.
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Production only: comma-separated proxy IPs or CIDRs that append X-Forwarded-For.
# Example: BETTER_AUTH_TRUSTED_PROXIES="192.0.2.10,10.0.0.0/24"
# Never include client IPs or wide public ranges here.
BETTER_AUTH_TRUSTED_PROXIES=""
